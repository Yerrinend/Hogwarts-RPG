# Publication allowlist: everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/Start-RPG.cmd
!/scripts/
!/docs/
!/sync/
!/.github/
!/rpg/
/rpg/*
!/rpg/quick_save.md
!/rpg/current_save.md
!/rpg/current_stats.md
!/rpg/state.json
!/rpg/character_canon.md
!/rpg/game_rules.md
!/rpg/relationship_history.md
!/rpg/full_timeline.md
!/rpg/future_plans.md
!/rpg/inventory.md
!/rpg/campaign_log.md
!/rpg/audit_and_uncertainties.md
!/rpg/version_map.json
!/rpg/turn_journal/
!/rpg/stages/
/rpg/stages/*
!/rpg/stages/*_review.md
**/__pycache__/
**/*.pyc
**/.env*
**/*.pem
**/*.key
**/*.html
**/*.htm
**/*.zip
**/*.bak
**/*.log
**/*.tmp
**/backups/
**/.local/
**/.sync/
